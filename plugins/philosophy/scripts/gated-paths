#!/usr/bin/env python3
"""gated-paths: list the files in a plan that CODEOWNERS gates.

    gated-paths <plan.md> [--root DIR]

Reads the plan's Files that change and the repository's CODEOWNERS (`.github/`, the
root, or `docs/`, as GitHub looks). Prints each gated path with its owners, one per
line. Exit 0 means none is gated, 1 means some are, and 2 means the plan could not be
read. With no CODEOWNERS, nothing is gated.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import artefact as a  # noqa: E402
import loop  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="gated-paths", description=__doc__.splitlines()[0])
    top.add_argument("plan", type=Path)
    top.add_argument("--root", type=Path, default=None, help="the repository root")
    args = top.parse_args(argv)
    try:
        plan = a.read(args.plan)
    except a.ArtefactError as error:
        print("gated-paths: %s" % error, file=sys.stderr)
        return 2
    if plan is None:
        print("gated-paths: %s does not exist" % args.plan, file=sys.stderr)
        return 2
    rules = loop.load_rules(args.root or loop.repo_root(args.plan.resolve().parent))
    hits = loop.gated(a.listed_paths(plan), rules)
    for path in hits:
        print("%s\t%s" % (path, " ".join(loop.owners_of(path, rules))))
    return 1 if hits else 0


if __name__ == "__main__":
    raise SystemExit(main())
