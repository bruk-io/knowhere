#!/usr/bin/env python3
"""next-change: say which change of an intent's spec to build next.

    next-change <intent-dir> [--remote NAME | --no-remote]

Reads the delivery order in `<intent-dir>/spec.md`. A change is done when its plan is in
`<intent-dir>/plans/`, and taken when a `build/<slug>/NN` branch exists on the remote
(origin by default), open or not: it reads branches, not PRs, so it needs no GitHub.
Abandon a build by deleting its branch, or the intent waits on it. Prints one line:

    build NN<TAB><title><TAB>R1, R2   the next change to build; exit 0
    taken NN<TAB><title>              the next change is already being built; exit 1
    done                              every change has a plan; exit 1

Exit 2 means the spec or the remote could not be read.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import artefact as a  # noqa: E402
import loop  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="next-change", description=__doc__.splitlines()[0])
    top.add_argument("intent", type=Path, help="the intent directory, such as intent/<slug>")
    remote = top.add_mutually_exclusive_group()
    remote.add_argument("--remote", default="origin", help="where build branches live")
    remote.add_argument("--no-remote", action="store_true", help="count only local plans")
    args = top.parse_args(argv)
    try:
        found = loop.find_next(args.intent, None if args.no_remote else args.remote)
    except (loop.LoopError, a.ArtefactError) as error:
        print("next-change: %s" % error, file=sys.stderr)
        return 2
    if found.change is None:
        print("done")
        return 1
    change = found.change
    if found.step is loop.Step.TAKEN:
        print("taken %s\t%s" % (change.number, change.title))
        return 1
    delivers = ", ".join("R%d" % number for number in change.delivers)
    print("build %s\t%s\t%s" % (change.number, change.title, delivers))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
