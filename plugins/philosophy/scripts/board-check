#!/usr/bin/env python3
"""board-check: assert that a Backlog.md board follows the work loop's conventions.

    board-check [all]              the whole board: config, sizes, moved finish lines,
                                   closed tasks, plans in progress, specs
    board-check ready <id>         whether a draft is understood well enough to accept
    board-check plan <id>          whether a leaf's plan has its sections and files
    board-check spec <doc> [--coverage]
                                   whether a spec is linked, complete and numbered;
                                   with --coverage, whether every requirement is cited
    board-check close <id>         whether the criteria and children let a task close
    board-check parallel <id> <id>...
                                   whether tasks can run at once: no shared files, no
                                   task waiting on another
    board-check route <id>         the model and effort for a task, from its type and size
    board-check route --sweep      the model for a sweep that has to read
    board-check size | moved | config

Each finding is one line, `<id> <check>: <what is wrong and how to fix it>`, or a JSON
list with --json. Exit 0 means clean, 1 means findings, and 2 means the board or the
id could not be read.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))

import board as b  # noqa: E402


def parser() -> argparse.ArgumentParser:
    top = argparse.ArgumentParser(
        prog="board-check",
        description="Assert that a Backlog.md board follows the work loop's conventions.",
    )
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument(
        "--root",
        type=Path,
        default=argparse.SUPPRESS,
        help="the repository holding backlog/ (default: found from the current directory)",
    )
    shared.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    top.add_argument("--root", type=Path, default=None, help=argparse.SUPPRESS)
    top.add_argument("--json", action="store_true", default=False, help="print findings as JSON")
    checks = top.add_subparsers(dest="check", metavar="CHECK")
    for name, about in (
        ("all", "the whole board (the default)"),
        ("size", "one valid size on every open task, nothing at 8 started unsplit"),
        ("moved", "criteria changed since acceptance without the finish-moved label"),
        ("config", "the work loop's types in backlog/config.yml"),
    ):
        checks.add_parser(name, parents=[shared], help=about)
    for name, about in (
        ("ready", "whether a draft is understood well enough to accept"),
        ("plan", "whether a leaf's plan has its sections and files"),
        ("close", "whether the criteria and children let a task close"),
    ):
        checks.add_parser(name, parents=[shared], help=about).add_argument("id")
    together = checks.add_parser("parallel", parents=[shared], help="whether tasks can run at once")
    together.add_argument("ids", nargs="+")
    routing = checks.add_parser("route", parents=[shared], help="the model and effort for a task")
    routing.add_argument("id", nargs="?")
    routing.add_argument("--sweep", action="store_true", help="for a sweep, not a task")
    spec = checks.add_parser("spec", parents=[shared], help="whether a spec is complete")
    spec.add_argument("doc", help="the doc id, such as doc-1, or its path")
    spec.add_argument("--coverage", action="store_true", help="every requirement is cited")
    return top


def run(args: argparse.Namespace, root: Path) -> tuple[list[b.Finding], str, Optional[dict]]:
    """The findings, the line to print when there are none, and an answer to print instead."""
    board = b.load_board(root)
    check = args.check or "all"
    unchecked = "" if b.has_history(root) else " (finish lines not checked: no git history)"
    if check == "all":
        found = b.check_board(board, b.accepted_versions(root, board))
        return found, "%d tasks, %d docs%s" % (len(board.tasks), len(board.docs), unchecked), None
    if check == "size":
        return b.check_sizes(board), "sizes", None
    if check == "config":
        return b.check_config(board), "config", None
    if check == "moved":
        accepted = b.accepted_versions(root, board)
        found = []
        for task in board.tasks:
            if task.id in accepted:
                commit, criteria = accepted[task.id]
                found += b.check_moved(task, criteria, commit)
        return found, "no finish line moved unlabelled%s" % unchecked, None
    if check == "spec":
        doc = b.find_doc(board, args.doc)
        if doc is None:
            raise LookupError("no doc %r under backlog/docs" % args.doc)
        return b.check_spec(board, doc, args.coverage), "%s spec" % doc.id, None
    if check == "parallel":
        if len(args.ids) < 2:
            raise LookupError("parallel needs two or more tasks")
        tasks = []
        for raw in args.ids:
            found = b.find_task(board, raw)
            if found is None:
                raise LookupError("no task %r on the board" % raw)
            tasks.append(found)
        names = ", ".join(t.id for t in tasks)
        return b.check_parallel(board, tuple(tasks)), "%s can run at once" % names, None
    if check == "route" and args.sweep:
        return [], "sweep route: %s (%s)" % (b.SWEEP.model, b.SWEEP.why), b.SWEEP._asdict()
    if getattr(args, "id", None) is None:
        raise LookupError("name a task, or pass --sweep")
    task = b.find_task(board, args.id)
    if task is None:
        raise LookupError("no task %r on the board" % args.id)
    if check == "route":
        chosen, found = b.route(board, task)
        if chosen is None:
            return found, "", None
        effort = " at %s effort" % chosen.effort if chosen.effort else ""
        line = "%s route: %s%s (%s)" % (task.id, chosen.model, effort, chosen.why)
        return [], line, {"id": task.id, **chosen._asdict()}
    if check == "ready":
        return b.check_ready(board, task), "%s ready" % task.id, None
    if check == "plan":
        return b.check_plan(board, task), "%s plan" % task.id, None
    return b.closing_findings(root, board, task), "%s can close" % task.id, None


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    root = args.root or b.find_root(Path.cwd())
    if root is None or not (root / "backlog" / "config.yml").is_file():
        print("board-check: no backlog/config.yml here or above; pass --root", file=sys.stderr)
        return 2
    try:
        found, clean, answer = run(args, root)
    except (LookupError, OSError, UnicodeDecodeError) as error:
        print("board-check: %s" % error, file=sys.stderr)
        return 2
    if found or answer is None:
        print(b.render(found, args.json, clean))
    else:
        print(json.dumps(answer) if args.json else clean)
    return 1 if found else 0


if __name__ == "__main__":
    raise SystemExit(main())
