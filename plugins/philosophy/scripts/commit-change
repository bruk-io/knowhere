#!/usr/bin/env python3
"""commit-change: commit the paths a plan lists, and nothing else.

    commit-change <plan.md> -m <message> [--plan-only] [--root DIR]

Stages the plan and the paths its Files that change lists, then commits them as a new
commit. `--plan-only` stages the plan alone, for the plan-first commit. A listed path
that does not exist and is not tracked is skipped: the change has not created it yet.

The build play runs this instead of `git add` and `git commit`, because a permission
rule such as `git add *` also lets through `git add -A`, which commits stray files, and
`git commit --amend`, which rewrites a commit already pushed. The plan is the scope of
the change, so the script stages from the plan and has no amend option.

A listed path is refused, before anything is staged, when it is absolute, escapes the
repository, is compiled Python (`.pyc`, `__pycache__`), or is gitignored. Exit 0 means
committed, 1 means a path was refused or there was nothing to commit, and 2 means it
could not tell (the plan is unreadable or git failed), with the reason on stderr.
"""

from __future__ import annotations

import argparse
import posixpath
import subprocess
import sys
from collections.abc import Collection, Iterable
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import artefact as a  # noqa: E402


def _normal(path: str) -> str:
    return posixpath.normpath(path)


def refused(path: str, ignored: Collection[str]) -> str | None:
    """The reason a path may not be staged, or None when it may."""
    normal = _normal(path)
    if path.startswith("/") or normal == ".." or normal.startswith("../"):
        return "it is outside the repository"
    parts = normal.split("/")
    if "__pycache__" in parts or normal.endswith(".pyc"):
        return "it is compiled Python"
    if normal in ignored or path in ignored:
        return "it is gitignored"
    return None


def to_stage(listed: Iterable[str], plan_path: str) -> tuple[str, ...]:
    """The normalised, de-duplicated paths to stage, the plan first."""
    seen: dict[str, None] = {_normal(plan_path): None}
    for path in listed:
        seen.setdefault(_normal(path), None)
    return tuple(seen)


class _GitError(RuntimeError):
    """A git command that failed."""


def _git(root: Path, *args: str, stdin: str | None = None) -> str:
    done = subprocess.run(
        ["git", "-C", str(root), *args],
        input=stdin,
        capture_output=True,
        encoding="utf-8",
        errors="replace",
        timeout=60,
        check=False,
    )
    if done.returncode not in (0, 1) or (done.returncode == 1 and done.stderr.strip()):
        raise _GitError("git %s failed: %s" % (args[0], done.stderr.strip()))
    return done.stdout


def _ignored(root: Path, paths: Iterable[str]) -> set[str]:
    out = _git(root, "check-ignore", "-z", "--stdin", stdin="".join(p + "\0" for p in paths))
    return {p for p in out.split("\0") if p}


def _tracked(root: Path, path: str) -> bool:
    return bool(_git(root, "ls-files", "--", path).strip())


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="commit-change", description=__doc__.splitlines()[0])
    top.add_argument("plan", type=Path)
    top.add_argument("-m", "--message", required=True)
    top.add_argument("--plan-only", action="store_true", help="stage the plan alone")
    top.add_argument("--root", type=Path, default=Path.cwd(), help="the repository")
    args = top.parse_args(argv)
    root = args.root.resolve()
    # A relative plan is relative to the repository, like every path in it, not to the
    # directory the command happens to run from.
    plan_file = args.plan if args.plan.is_absolute() else root / args.plan
    try:
        plan = a.read(plan_file)
    except a.ArtefactError as error:
        print("commit-change: %s" % error, file=sys.stderr)
        return 2
    if plan is None:
        print("commit-change: %s does not exist" % plan_file, file=sys.stderr)
        return 2
    try:
        plan_path = str(plan_file.resolve().relative_to(root))
    except ValueError:
        plan_path = str(args.plan)  # outside the repository: `refused` names it
    wanted = () if args.plan_only else a.listed_paths(plan)
    paths = to_stage(wanted, plan_path)
    try:
        # git refuses to check a path outside the repository, so ask only about the rest
        ignored = _ignored(root, [p for p in paths if refused(p, ()) is None])
        problems = [(p, r) for p in paths for r in [refused(p, ignored)] if r]
        if problems:
            for path, reason in problems:
                print("commit-change: not staging %s: %s" % (path, reason), file=sys.stderr)
            return 1
        present = [p for p in paths if (root / p).exists() or _tracked(root, p)]
        _git(root, "add", "-A", "--", *present)
        staged = _git(root, "diff", "--cached", "--name-only", "--", *present).strip()
        if not staged:
            print("commit-change: nothing to commit", file=sys.stderr)
            return 1
        # A listed directory stages what is under it, so check what was actually staged,
        # not only what was listed, and back out before committing anything refused.
        caught = [(p, r) for p in staged.splitlines() for r in [refused(p, set())] if r]
        if caught:
            _git(root, "reset", "-q", "--", *present)
            for path, reason in caught:
                print("commit-change: not staging %s: %s" % (path, reason), file=sys.stderr)
            return 1
        _git(root, "commit", "-m", args.message, "--", *present)
    except _GitError as error:
        print("commit-change: %s" % error, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
