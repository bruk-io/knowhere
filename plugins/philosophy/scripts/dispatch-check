#!/usr/bin/env python3
"""dispatch-check: whether a repository_dispatch for the loop is real and still due.

    dispatch-check spec|build <slug> --before SHA --sha SHA [--root DIR] [--remote NAME]

A `repository_dispatch` can be sent by anyone with a write-scoped token, with whatever
payload it likes, so the job it starts re-derives what `find` already decided from
`main`'s own history, rather than trusting the payload (loop-trigger-events/spec.md
R5). It exits 2, saying why, unless, in order: the slug matches `^[a-z0-9][a-z0-9-]*$`;
`before` and `sha` are each a full 40-hex sha other than all zeros; `sha` is a commit on
`main` and `before` is one of its ancestors; and the diff over that range, with the same
paths and filter `find` uses for the play (`--diff-filter=AM` on `intent/*/intent.md`
for `spec`; `intent/*/spec.md` and `intent/*/plans/*.md`, unfiltered, for `build`),
touches the slug's trigger path.

For `spec`, once that holds, it also asks whether `main` still calls for the play: exit
1, the run meant to stay green, when `intent/<slug>/spec.md` is already on `main` or a
`spec/<slug>` branch is already on the remote (default `origin`); exit 0 when the spec
is still due.

For `build`, it exits 0 once the checks above hold. Whether the change itself is still
due is left to the existing `next-change` step, which already treats its own exit 1 as
a skip.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from enum import Enum
from pathlib import Path
from typing import NamedTuple, Optional

SLUG = re.compile(r"[a-z0-9][a-z0-9-]*")
FULL_SHA = re.compile(r"[0-9a-f]{40}")
ZERO_SHA = "0" * 40
GIT_TIMEOUT = 60


class Play(Enum):
    SPEC = "spec"
    BUILD = "build"


# `find`'s own paths and filter for each play: dispatch-check must re-derive the same
# diff `find` already took, never a different one, or the two could disagree.
TRIGGER_PATHS: dict[Play, tuple[tuple[str, ...], Optional[str]]] = {
    Play.SPEC: (("intent/*/intent.md",), "AM"),
    Play.BUILD: (("intent/*/spec.md", "intent/*/plans/*.md"), None),
}


class Facts(NamedTuple):
    sha_on_main: bool
    before_is_ancestor: bool
    touches_slug: bool
    spec_on_main: bool
    spec_branch_exists: bool


# --- the logic: plain data in, a verdict out -----------------------------------------


def malformed(slug: str, before: str, sha: str) -> Optional[str]:
    """None if the slug and both shas are well-formed; otherwise, why not."""
    if not SLUG.fullmatch(slug):
        return (
            "%r is not a plain slug: use lowercase letters, digits and '-', not starting "
            "with '-'" % slug
        )
    if not _full_sha(before):
        return "before (%r) is not a full commit sha" % before
    if not _full_sha(sha):
        return "sha (%r) is not a full commit sha" % sha
    return None


def verdict(play: Play, slug: str, before: str, sha: str, facts: Facts) -> tuple[int, str]:
    """The exit code and the reason, from the facts a dispatch's claim rests on.

    Call only once `malformed` has returned None: the shas are assumed well-formed."""
    if not facts.sha_on_main:
        return 2, "%s is not a commit on main" % sha
    if not facts.before_is_ancestor:
        return 2, "%s is not an ancestor of %s" % (before, sha)
    if not facts.touches_slug:
        return 2, "%s..%s touches no trigger path for %s" % (before, sha, slug)
    if play is Play.SPEC:
        if facts.spec_on_main:
            return 1, "intent/%s/spec.md is already on main" % slug
        if facts.spec_branch_exists:
            return 1, "spec/%s is already on the remote" % slug
    return 0, "due"


def _full_sha(value: str) -> bool:
    return bool(FULL_SHA.fullmatch(value)) and value != ZERO_SHA


# --- the shell: everything that reads git --------------------------------------------


def _git(root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        capture_output=True,
        encoding="utf-8",
        errors="replace",
        timeout=GIT_TIMEOUT,
    )


def main_ref(root: Path, remote: str) -> str:
    """`main`, or `<remote>/main` where there is no local `main`."""
    local = _git(root, "rev-parse", "--verify", "--quiet", "refs/heads/main")
    return "main" if local.returncode == 0 else "%s/main" % remote


def is_ancestor(root: Path, ancestor: str, descendant: str) -> bool:
    return _git(root, "merge-base", "--is-ancestor", ancestor, descendant).returncode == 0


def diffed_paths(
    root: Path, before: str, sha: str, paths: tuple[str, ...], diff_filter: Optional[str]
) -> tuple[str, ...]:
    args = ["diff", "--name-only"]
    if diff_filter:
        args.append("--diff-filter=%s" % diff_filter)
    done = _git(root, *args, before, sha, "--", *paths)
    return tuple(line for line in done.stdout.splitlines() if line)


def path_exists_at(root: Path, ref: str, path: str) -> bool:
    return _git(root, "cat-file", "-e", "%s:%s" % (ref, path)).returncode == 0


def remote_branch_exists(root: Path, remote: str, branch: str) -> bool:
    # The full ref: a bare `spec/<slug>` would also match `refs/heads/x/spec/<slug>`.
    return bool(_git(root, "ls-remote", remote, "refs/heads/%s" % branch).stdout.strip())


def gather_facts(root: Path, remote: str, play: Play, slug: str, before: str, sha: str) -> Facts:
    """Raises nothing: a git call that fails (an unknown sha, an unreachable remote)
    reads as the fact being false, which `verdict` turns into the matching exit 2."""
    ref = main_ref(root, remote)
    paths, diff_filter = TRIGGER_PATHS[play]
    diffed = diffed_paths(root, before, sha, paths, diff_filter)
    touches_slug = slug in {name.split("/", 2)[1] for name in diffed if name.startswith("intent/")}
    return Facts(
        sha_on_main=is_ancestor(root, sha, ref),
        before_is_ancestor=is_ancestor(root, before, sha),
        touches_slug=touches_slug,
        spec_on_main=play is Play.SPEC and path_exists_at(root, ref, "intent/%s/spec.md" % slug),
        spec_branch_exists=play is Play.SPEC
        and remote_branch_exists(root, remote, "spec/%s" % slug),
    )


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="dispatch-check", description=__doc__.splitlines()[0])
    top.add_argument("play", choices=[play.value for play in Play])
    top.add_argument("slug")
    top.add_argument("--before", required=True)
    top.add_argument("--sha", required=True)
    top.add_argument("--root", type=Path, default=Path.cwd())
    top.add_argument("--remote", default="origin")
    args = top.parse_args(argv)

    reason = malformed(args.slug, args.before, args.sha)
    if reason is None:
        play = Play(args.play)
        facts = gather_facts(args.root, args.remote, play, args.slug, args.before, args.sha)
        code, reason = verdict(play, args.slug, args.before, args.sha, facts)
    else:
        code = 2

    if code == 2:
        print("dispatch-check: %s" % reason, file=sys.stderr)
    else:
        print(reason)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
