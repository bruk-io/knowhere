#!/usr/bin/env python3
"""branch-diff: print a branch's commits and its diff against main, for a review.

    branch-diff <branch> [--root DIR]

Prints `git log main..<branch>`, then `git diff main...<branch>`, using `origin/main`
when there is no local `main`, as in a CI checkout. The review play runs this for a
branch instead of git itself, because a permission rule such as `git diff main...*`
would also let through options like `--output=<file>`.

The branch must be letters, digits, `.`, `_`, `/` and `-`, not starting with `-` and
without `..`, so it can only be read as a branch. The diff runs with `--no-ext-diff
--no-textconv`, so no program the repository configures runs. Exits 2, saying why,
when the name is refused or git fails.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

BRANCH = re.compile(r"^[A-Za-z0-9._/][A-Za-z0-9._/-]*$")


def plain_branch(name: str) -> bool:
    """Whether a name can only be read as a branch: no option, no range, no spaces."""
    return bool(BRANCH.match(name)) and ".." not in name


def git(root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        capture_output=True,
        encoding="utf-8",
        errors="replace",
        timeout=60,
    )


def base(root: Path) -> str:
    """`main`, or `origin/main` where there is no local `main`."""
    local = git(root, "rev-parse", "--verify", "--quiet", "refs/heads/main")
    return "main" if local.returncode == 0 else "origin/main"


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="branch-diff", description=__doc__.splitlines()[0])
    top.add_argument("branch")
    top.add_argument("--root", type=Path, default=Path.cwd(), help="the repository")
    args = top.parse_args(argv)
    if not plain_branch(args.branch):
        print(
            "branch-diff: %r is not a plain branch name: use letters, digits, '.', '_', '/' "
            "and '-', not starting with '-' and without '..'" % args.branch
        )
        return 2
    main_branch = base(args.root)
    log = git(args.root, "log", "--no-color", "%s..%s" % (main_branch, args.branch), "--")
    diff = git(
        args.root,
        "diff",
        "--no-color",
        "--no-ext-diff",
        "--no-textconv",
        "%s...%s" % (main_branch, args.branch),
        "--",
    )
    for done in (log, diff):
        if done.returncode != 0:
            print("branch-diff: git failed: %s" % done.stderr.strip())
            return 2
    print("$ git log %s..%s\n%s" % (main_branch, args.branch, log.stdout))
    print("$ git diff %s...%s\n%s" % (main_branch, args.branch, diff.stdout), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
