#!/usr/bin/env python3
"""run-check: run the repository's declared check and print it as evidence.

    run-check fast|full [--lines N] [--timeout SECONDS] [--root DIR]

Runs the command `.claude/checks.json` declares for the tier, from the repository root,
and prints a block to paste into a PR: the command, the last N lines of its output (40
by default), and its exit code. Exits with the check's own exit code, so it works as
the check. A check that runs past the timeout (30 minutes by default) is stopped and
reported with exit code 124. When there is nothing to run (no command declared for the tier, or an
unreadable `.claude/checks.json`) it exits 2 and prints a line starting `run-check:`
instead of an evidence block, so that case can't be mistaken for a check exiting 2.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import loop  # noqa: E402


def non_negative(value: str) -> int:
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError("must be 0 or more")
    return number


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="run-check", description=__doc__.splitlines()[0])
    top.add_argument("tier", choices=loop.TIERS)
    top.add_argument("--lines", type=non_negative, default=40, help="output lines to keep")
    top.add_argument("--timeout", type=non_negative, default=1800, help="seconds to allow")
    top.add_argument("--root", type=Path, default=None, help="the repository root")
    args = top.parse_args(argv)
    root = args.root or loop.repo_root(Path.cwd())
    try:
        code, block = loop.run_declared(root, args.tier, args.lines, args.timeout)
    except (loop.LoopError, OSError, ValueError) as error:
        print("run-check: %s" % error)
        return 2
    print(block)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
