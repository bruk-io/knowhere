#!/usr/bin/env python3
"""plan-drift: print the files a build branch changes beyond its plan.

    plan-drift <branch> [--root DIR]

`<branch>` must be `build/<slug>/NN`. Finds the one plan matching
`intent/<slug>/plans/NN-*.md` in the working tree, reads its Files that change, and
diffs the branch against `main` (`origin/main` where there is no local `main`, as in a
CI checkout). Prints each changed path that the plan does not list, one per line, then
why the check holds that line, and exits 1. Exits 0, silently, when there is none.
Exits 2, with the reason on stderr, when it could not tell: the branch name does not
fit, the plan is missing or not singular, or git failed.

Does not import `branch-diff`: a hyphenated script is not importable, so the base
choice is repeated here.
"""

from __future__ import annotations

import argparse
import posixpath
import re
import subprocess
import sys
from collections.abc import Iterable
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import artefact as a  # noqa: E402

BUILD_BRANCH = re.compile(r"build/([A-Za-z0-9-]+)/(\d{2})")
REASON = "plan-drift: the plan lists what the owner read, so a file beyond it was not read."


# --- the logic: plain data in, plain data out ---------------------------------------


def build_branch(name: str) -> tuple[str, str] | None:
    """The `(slug, number)` a `build/<slug>/NN` branch name carries, or None."""
    match = BUILD_BRANCH.fullmatch(name)
    return (match.group(1), match.group(2)) if match else None


def normalise(path: str) -> str:
    """A path normalised for comparison: `posixpath.normpath`, with a leading `./`
    dropped."""
    out = posixpath.normpath(path)
    return out[2:] if out.startswith("./") else out


def drift(changed: Iterable[str], listed: Iterable[str], plan_path: str) -> tuple[str, ...]:
    """The changed paths, normalised, that are neither listed nor the plan itself, in
    diff order."""
    listed_norm = frozenset(normalise(path) for path in listed)
    plan_norm = normalise(plan_path)
    out = []
    for path in changed:
        norm = normalise(path)
        if norm != plan_norm and norm not in listed_norm:
            out.append(norm)
    return tuple(out)


# --- the shell ------------------------------------------------------------------------


def git(root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        capture_output=True,
        encoding="utf-8",
        errors="replace",
        timeout=60,
    )


def base(root: Path) -> str:
    """`main`, or `origin/main` where there is no local `main`."""
    local = git(root, "rev-parse", "--verify", "--quiet", "refs/heads/main")
    return "main" if local.returncode == 0 else "origin/main"


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="plan-drift", description=__doc__.splitlines()[0])
    top.add_argument("branch")
    top.add_argument("--root", type=Path, default=Path.cwd(), help="the repository")
    args = top.parse_args(argv)

    parsed = build_branch(args.branch)
    if parsed is None:
        print(
            "plan-drift: %r is not a build branch: use build/<slug>/NN" % args.branch,
            file=sys.stderr,
        )
        return 2
    slug, number = parsed

    matches = sorted(args.root.glob("intent/%s/plans/%s-*.md" % (slug, number)))
    if len(matches) != 1:
        print(
            "plan-drift: found %d plan(s) matching intent/%s/plans/%s-*.md, need exactly one"
            % (len(matches), slug, number),
            file=sys.stderr,
        )
        return 2
    plan_file = matches[0]

    try:
        doc = a.read(plan_file)
    except a.ArtefactError as error:
        print("plan-drift: %s" % error, file=sys.stderr)
        return 2
    if doc is None:
        print("plan-drift: %s does not exist" % plan_file, file=sys.stderr)
        return 2
    listed = a.listed_paths(doc)

    main_branch = base(args.root)
    diff = git(
        args.root,
        "diff",
        "--name-only",
        "--no-renames",
        "-z",
        "%s...%s" % (main_branch, args.branch),
        "--",
    )
    if diff.returncode != 0:
        print("plan-drift: git failed: %s" % diff.stderr.strip(), file=sys.stderr)
        return 2
    changed = [path for path in diff.stdout.split("\0") if path]

    plan_rel = plan_file.resolve().relative_to(args.root.resolve()).as_posix()
    drifted = drift(changed, listed, plan_rel)
    if not drifted:
        return 0
    for path in drifted:
        print(path)
    print(REASON)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
