#!/usr/bin/env python3
"""band-check: say which control band the newest reading falls in.

    loop-readings <metric> | band-check --metric <name>

Reads a JSON list of readings on stdin, oldest first, either numbers or `[day, value]`
pairs, and prints one JSON line: the metric, the tier (`none`, `1sigma`, `2sigma` or
`3sigma`), the rule that tripped, the reading, and the baseline's mean and sigma. Exit 0
means a verdict was printed, and 2 means the readings were unreadable or too few.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import band  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="band-check", description=__doc__.splitlines()[0])
    top.add_argument("--metric", default="", help="the metric's name, for the output")
    args = top.parse_args(argv)
    try:
        raw = json.load(sys.stdin)
        readings = [float(r[1] if isinstance(r, list) else r) for r in raw]
        verdict = band.tier(readings)
    except (ValueError, TypeError, IndexError, band.BandError) as error:
        print("band-check: %s" % error, file=sys.stderr)
        return 2
    print(json.dumps({"metric": args.metric, **verdict._asdict()}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
