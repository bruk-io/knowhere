#!/usr/bin/env python3
"""loop-readings: one value per day for a metric the loop's control bands watch.

    loop-readings ci_failure_rate|pr_cycle_hours [--days N] [--repo OWNER/NAME]

Fetches the last N days (30 by default) of CI runs or merged PRs with `gh`, and prints a
JSON list of `[day, value]` pairs, oldest first, for band-check to read. Exit 2 means
`gh` failed.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import metrics  # noqa: E402

FETCH = {
    "ci_failure_rate": ["run", "list", "--limit", "1000", "--json", "conclusion,createdAt"],
    "pr_cycle_hours": [
        "pr",
        "list",
        "--state",
        "merged",
        "--limit",
        "500",
        "--json",
        "createdAt,mergedAt",
    ],
}
SHAPE = {"ci_failure_rate": metrics.ci_failure_rate, "pr_cycle_hours": metrics.pr_cycle_hours}


def main(argv: list[str] | None = None) -> int:
    top = argparse.ArgumentParser(prog="loop-readings", description=__doc__.splitlines()[0])
    top.add_argument("metric", choices=sorted(FETCH))
    top.add_argument("--days", type=int, default=30)
    top.add_argument("--repo", default=None)
    args = top.parse_args(argv)
    command = ["gh", *FETCH[args.metric]] + (["--repo", args.repo] if args.repo else [])
    done = subprocess.run(command, capture_output=True, text=True, check=False)
    if done.returncode != 0:
        print("loop-readings: gh failed: %s" % done.stderr.strip(), file=sys.stderr)
        return 2
    since = (datetime.now(timezone.utc) - timedelta(days=args.days)).date().isoformat()
    readings = [pair for pair in SHAPE[args.metric](json.loads(done.stdout)) if pair[0] >= since]
    print(json.dumps(readings))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
